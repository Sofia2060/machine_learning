# Môi trường ảo
venv/
.venv/
env/

# Python Cache & Checkpoints
__pycache__/
*.pyc
.ipynb_checkpoints/

# File dữ liệu nặng & Model Weights
data/raw/
data/processed/
*.dat
*.csv
*.pkl
*.joblib
*.npz
models/main_model/*_meta.json

# File hệ điều hành
.DS_Store
Thumbs.db

# IDE Config (Nên chặn để tránh xung đột cấu hình giữa các máy trong nhóm)
.vscode/
.idea/

# File cấu hình bảo mật & môi trường
.env
*.env

# File Cơ sở dữ liệu cục bộ (MySQL export / SQLite)
*.sql
*.sqlite3
*.db

# File log và báo cáo tạm
*.log
*.html

# Giữ lại cấu trúc thư mục rỗng trên Git (Bỏ qua nội dung nhưng không mất folder)
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

# Kết quả chạy (metrics, hình) và file nén
outputs/
*.zip
